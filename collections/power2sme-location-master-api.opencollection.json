            "name": "List of All city and state by pincode",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/locationmaster",
            "params": [
              {
                "name": "pincode",
                "value": "",
                "type": "query",
                "description": "pincode"
              }
            ]
          },
          "docs": "It will provide the list of all cities and states and location on the basis of pincode"
        },
        {
          "info": {
            "name": "List of All States",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/states"
