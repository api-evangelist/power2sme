          "info": {
            "name": "List of all cities of a state",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/cities",
            "params": [
              {
                "name": "stateid",
                "value": "",
                "type": "query",
                "description": "stateid"
              }
            ]
          },
          "docs": "It will provide All Cities of a State on the basis of State Id."
        },
        {
          "info": {
            "name": "List of All locations in Location Master",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/getalllocation"
          },
          "docs": "It will provide the list of all locations till present day."
